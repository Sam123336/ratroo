# Local NestJS transit API. Keep the /v1 suffix.
RATROO_API_URL=http://localhost:3000/v1

# For Vercel Preview and Production, replace the value with the deployed API:
# RATROO_API_URL=https://your-ratroo-backend.example.com/v1

# Client map renderer. "open" is bundled today. A future vendor adapter plugs
# into app/lib/maps/provider-registry.ts without changing Rider or planner UI.
NEXT_PUBLIC_MAP_PROVIDER=open
NEXT_PUBLIC_OPEN_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_OPEN_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OPEN_MAP_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_OPEN_MAP_PRIMARY_SOURCE_ID=openmaptiles

# Server-only reverse-geocoding provider: open | google
MAP_GEOCODING_PROVIDER=open

# Optional when using the open geocoder. Point this to your own Nominatim-compatible
# service in production if you need higher throughput.
OPEN_MAP_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
MAP_GEOCODING_USER_AGENT=RatrooTransit/1.0 (https://ratroo.vercel.app)

# Only needed when MAP_GEOCODING_PROVIDER=google. Never expose this server key
# through a NEXT_PUBLIC_ variable.
GOOGLE_MAPS_API_KEY=
